{
  "name": "Image → Video",
  "description": "Wan 2.2 14B, full 20-step quality. Animates a still image from a motion prompt.",
  "output": "video",
  "preset": true,
  "order": 1,
  "size": {
    "width": "width",
    "height": "height",
    "from": "image",
    "multiple": 16
  },
  "models": [
    "wan2.2_i2v_high_noise_14B_fp8_scaled.safetensors",
    "wan2.2_i2v_low_noise_14B_fp8_scaled.safetensors"
  ],
  "fields": [
    {
      "key": "prompt",
      "label": "Prompt",
      "type": "text",
      "default": "The camera slowly pushes in while the subject turns their head and smiles, hair moving in a light breeze.",
      "targets": [
        [
          "2",
          "text"
        ]
      ],
      "help": "Describe the motion and the camera. The image already sets the look."
    },
    {
      "key": "negative",
      "label": "Negative prompt",
      "type": "text",
      "default": "色调艳丽，过曝，静态，细节模糊不清，字幕，风格，作品，画作，画面，静止，整体发灰，最差质量，低质量，JPEG压缩残留，丑陋的，残缺的，多余的手指，画得不好的手部，画得不好的脸部，畸形的，毁容的，形态畸形的肢体，手指融合，静止不动的画面，杂乱的背景，三条腿，背景人很多，倒着走",
      "targets": [
        [
          "3",
          "text"
        ]
      ],
      "hidden": true
    },
    {
      "key": "image",
      "label": "Start image",
      "type": "image",
      "default": "",
      "targets": [
        [
          "5",
          "image"
        ]
      ]
    },
    {
      "key": "width",
      "label": "Width",
      "type": "int",
      "default": 832,
      "min": 256,
      "max": 1920,
      "step": 16,
      "targets": [
        [
          "10",
          "width"
        ]
      ]
    },
    {
      "key": "height",
      "label": "Height",
      "type": "int",
      "default": 480,
      "min": 256,
      "max": 1920,
      "step": 16,
      "targets": [
        [
          "10",
          "height"
        ]
      ]
    },
    {
      "key": "length",
      "label": "Frames",
      "type": "int",
      "default": 81,
      "min": 5,
      "max": 241,
      "step": 4,
      "targets": [
        [
          "10",
          "length"
        ]
      ],
      "help": "81 frames is about 5 seconds at 16 fps. Use 4n+1."
    },
    {
      "key": "fps",
      "label": "FPS",
      "type": "float",
      "default": 16,
      "min": 8,
      "max": 60,
      "step": 1,
      "targets": [
        [
          "14",
          "fps"
        ]
      ]
    },
    {
      "key": "steps",
      "label": "Steps",
      "type": "int",
      "default": 20,
      "min": 6,
      "max": 60,
      "step": 2,
      "targets": [
        [
          "11",
          "steps"
        ],
        [
          "12",
          "steps"
        ],
        [
          "11",
          "end_at_step",
          "half"
        ],
        [
          "12",
          "start_at_step",
          "half"
        ]
      ],
      "help": "Split evenly between the high-noise and low-noise models."
    },
    {
      "key": "cfg",
      "label": "CFG",
      "type": "float",
      "default": 3.5,
      "min": 1,
      "max": 10,
      "step": 0.5,
      "targets": [
        [
          "11",
          "cfg"
        ],
        [
          "12",
          "cfg"
        ]
      ],
      "hidden": false
    },
    {
      "key": "seed",
      "label": "Seed",
      "type": "seed",
      "default": 0,
      "min": 0,
      "max": 2147483647,
      "targets": [
        [
          "11",
          "noise_seed"
        ]
      ]
    }
  ]
}