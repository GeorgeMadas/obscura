{
  "name": "Motion transfer",
  "description": "Wan Animate 2: your character performs the motion from a driving video. Background follows the prompt.",
  "output": "video",
  "preset": true,
  "order": 3,
  "size": {
    "width": "width",
    "height": "height",
    "from": "image",
    "multiple": 16
  },
  "models": [
    "wan_animate_2_int8_convrot.safetensors",
    "lightx2v_I2V_14B_480p_cfg_step_distill_rank64_bf16.safetensors",
    "clip_vision_h.safetensors",
    "Wan2_1_VAE_bf16.safetensors"
  ],
  "fields": [
    {
      "key": "prompt",
      "label": "Prompt",
      "type": "text",
      "default": "Character description: a young woman with long dark hair in a red jacket.\nBackground description: a sunlit city street.",
      "targets": [
        [
          "6",
          "text"
        ]
      ],
      "help": "Describe how the character and background look. No motion words."
    },
    {
      "key": "motion",
      "label": "Motion prompt",
      "type": "text",
      "default": "A person dancing energetically, background stationary.",
      "targets": [
        [
          "8",
          "text"
        ]
      ],
      "help": "Describe the motion in the driving video."
    },
    {
      "key": "negative",
      "label": "Negative prompt",
      "type": "text",
      "default": "色调艳丽，过曝，静态，细节模糊不清，字幕，风格，作品，画作，画面，静止，整体发灰，最差质量，低质量，JPEG压缩残留，丑陋的，残缺的，多余的手指，画得不好的手部，画得不好的脸部，畸形的，毁容的，形态畸形的肢体，手指融合，静止不动的画面，杂乱的背景，三条腿，背景人很多，倒着走",
      "targets": [
        [
          "7",
          "text"
        ]
      ],
      "hidden": true
    },
    {
      "key": "image",
      "label": "Character image",
      "type": "image",
      "default": "",
      "targets": [
        [
          "11",
          "image"
        ]
      ]
    },
    {
      "key": "video",
      "label": "Driving video",
      "type": "video",
      "default": "",
      "targets": [
        [
          "12",
          "file"
        ]
      ],
      "help": "Its motion is copied onto the character. Keep the framing similar (full body to full body)."
    },
    {
      "key": "width",
      "label": "Width",
      "type": "int",
      "default": 480,
      "min": 256,
      "max": 1920,
      "step": 16,
      "targets": [
        [
          "15",
          "resize_type.width"
        ],
        [
          "16",
          "resize_type.width"
        ],
        [
          "20",
          "width"
        ]
      ]
    },
    {
      "key": "height",
      "label": "Height",
      "type": "int",
      "default": 832,
      "min": 256,
      "max": 1920,
      "step": 16,
      "targets": [
        [
          "15",
          "resize_type.height"
        ],
        [
          "16",
          "resize_type.height"
        ],
        [
          "20",
          "height"
        ]
      ]
    },
    {
      "key": "length",
      "label": "Frames",
      "type": "int",
      "default": 81,
      "min": 5,
      "max": 241,
      "step": 4,
      "targets": [
        [
          "14",
          "length"
        ],
        [
          "20",
          "length"
        ]
      ],
      "help": "Frames taken from the start of the driving video, played at its frame rate. Use 4n+1."
    },
    {
      "key": "steps",
      "label": "Steps",
      "type": "int",
      "default": 6,
      "min": 4,
      "max": 20,
      "step": 1,
      "targets": [
        [
          "22",
          "steps"
        ]
      ]
    },
    {
      "key": "pose_strength",
      "label": "Motion strength",
      "type": "float",
      "default": 1.0,
      "min": 0,
      "max": 2,
      "step": 0.05,
      "targets": [
        [
          "20",
          "pose_strength"
        ]
      ]
    },
    {
      "key": "reference_strength",
      "label": "Identity strength",
      "type": "float",
      "default": 1.0,
      "min": 0,
      "max": 2,
      "step": 0.05,
      "targets": [
        [
          "20",
          "reference_image_strength"
        ]
      ]
    },
    {
      "key": "seed",
      "label": "Seed",
      "type": "seed",
      "default": 0,
      "min": 0,
      "max": 2147483647,
      "targets": [
        [
          "23",
          "noise_seed"
        ]
      ]
    }
  ]
}